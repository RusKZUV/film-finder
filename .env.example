# Film Finder - Environment Variables Example
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# The Movie Database (TMDB) API Read Access Token or API Key
# Sign up and get your key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key_here"

# OpenAI API Key for natural language understanding and candidate ranking
# Create an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"
